{
  "schemaVersion": 1,
  "id": "wyml",
  "version": "${version}",
  "name": "WhyYouMakeLag",
  "description": "Server-side tools for diagnosing and controlling mob spawning lag.",
  "authors": [
    "CreeperHost"
  ],
  "license": "BSD-4-Clause",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.creeperhost.wyml.fabric.WymlModFabric"
    ],
    "client": [
      "net.creeperhost.wyml.fabric.WymlModFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "polylib": ">=${polylib_mod_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "mixins": [
    "wyml.mixins.json"
  ]
}
